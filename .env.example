# ========================================
# 必需變數（Backend）
# ========================================

# MongoDB Atlas 連接字串（必需）
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT 加密密鑰（必需，用於 admin 驗證）
# 生成方式: openssl rand -hex 32
JWT_SECRET=your-64-character-random-secret-key

# Admin 後台登入密碼（必需）
ADMIN_PASSWORD=admin123

# ========================================
# 開發環境變數
# ========================================

# 伺服器端口（開發環境，Heroku 會自動設置）
PORT=3001

# 前端開發時的 Backend URL
VITE_BACKEND_ORIGIN=http://localhost:3001

# GraphQL 端點路徑
VITE_GRAPHQL_ENDPOINT=/graphql

# ========================================
# 可選變數（生產環境）
# ========================================

# Cloudflare Turnstile 驗證碼（生產環境）
# 開發環境會自動使用測試密鑰 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAC2vj0xOA6Fpx2cd
TURNSTILE_SECRET_KEY=your_turnstile_secret

# Google Gemini API（前端 AI 功能，可選）
GEMINI_API_KEY=your_gemini_api_key

# ========================================
# Heroku 部署注意事項
# ========================================
# 1. NODE_ENV=production 會在 Heroku 自動設置
# 2. PORT 由 Heroku 自動分配
# 3. 前端環境變數（VITE_*）需要在構建時設置
# 4. 詳細說明請參考: HEROKU_DEPLOYMENT.md
